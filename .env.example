# --- pstack version ที่ pin (ดู CHANGELOG ของ pstack ก่อนอัปเกรด) ---
PSTACK_REF=v0.1.0
# ถ้า pstack ยังเป็น private repo: PAT ที่อ่าน repo pstack ได้ (ใช้ตอน docker build)
GIT_TOKEN=

# --- pstack settings ---
PSTACK_DEBUG=true
PSTACK_SECRET_KEY=change-me-to-a-long-random-string
PSTACK_DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app
PSTACK_REDIS_URL=redis://redis:6379/0

# โมดูลที่เปิดใช้ (ของ pstack + ของ app นี้)
PSTACK_MODULES=users,demo
# addons ของ pstack + ของ app นี้ (ใน Docker คือ path ใน image; dev บนเครื่องใช้ ../pstack/addons)
PSTACK_ADDONS_PATHS=addons,app_addons

PSTACK_ADMIN_EMAIL=admin@example.com
PSTACK_ADMIN_PASSWORD=admin

# ai_agent (ถ้าเปิดใช้)
ANTHROPIC_API_KEY=

# --- postgres container ---
DB_NAME=app
DB_USER=app
DB_PASSWORD=app
